# Copy this file to .env and fill it in:   cp .env.example .env
# .env is git-ignored. Never commit real keys. Step-by-step: docs/00-setup.md

# --- OpenAI: the model and the embeddings (needed from Lab 1) -----------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Langfuse: traces, prompts, datasets, experiments (needed from Lab 2) ------
# Langfuse -> your project -> Settings -> API Keys -> Create new API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Pick the region your project lives in:
#   EU: https://cloud.langfuse.com        US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Pinecone: the vector database for long-term memory (needed from Lab 4) ---
# https://app.pinecone.io -> API Keys
PINECONE_API_KEY=

# --- Optional settings (the defaults are fine) --------------------------------
# AGENT_MODEL=gpt-5-mini
# JUDGE_MODEL=gpt-5-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# PINECONE_INDEX=ridgeline-agent
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# LANGFUSE_PROMPT_NAME=front-desk
# LANGFUSE_PROMPT_LABEL=production
# LANGFUSE_DATASET=ridgeline-agent-cases
# AGENT_MAX_STEPS=6
